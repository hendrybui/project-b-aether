[Unit]
Description=AudioMass API — rebuilt backend (FastAPI, the mixer's engine)
After=network.target docker.service

[Service]
Type=simple
WorkingDirectory=/mnt/Pandora/Project-B
# The single backend since cutover (2026-08-27): serves the REST contract
# from API-CONTRACT.md to the Stem Mixer (:5058) and Aether (bounce upload).
Environment=AUDIOMASS_PORT=5055
Environment=AUDIOMASS_DEMUCS_DOCKER_IMAGE=rocm64_gfx803_demucs:2.4
ExecStart=/mnt/Pandora/Project-B/backend/.venv/bin/python -m uvicorn app:app --host 0.0.0.0 --port 5055 --app-dir backend
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
