[Unit]
Description=AudioMass FastAPI Backend (port 5055)
After=network.target

[Service]
Type=simple
WorkingDirectory=/mnt/Pandora/Project-B/audiomass/backend
ExecStart=/mnt/Pandora/Project-B/audiomass/.venv/bin/python -m uvicorn app:app --host 0.0.0.0 --port 5055
Restart=on-failure
RestartSec=3
Environment=AUDIOMASS_PORT=5055

[Install]
WantedBy=default.target
